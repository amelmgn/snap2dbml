# The server always listens on port 3000 inside the container.
PORT=3000

# Use a staging-only secret key for API authentication (X-API-Key).
API_KEY=change-me-to-a-strong-random-staging-secret

# Minimum log level: debug | info | warn | error.
LOG_LEVEL=info

# GitHub account or organization that owns the published image.
GHCR_OWNER=your-github-username

# Staging image tag. Pin to an immutable sha-* tag when needed.
#STAGE_IMAGE_TAG=stage

# Optional: path inside the container to a sandbox sync configuration.
SYNC_CONFIG=

# Secrets referenced as ${VAR} in a mounted sync.json.
DIRECTUS_TOKEN=your-directus-static-token
GITHUB_TOKEN=your-github-pat-with-repo-write
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
