# GitHub account or organization that owns the published image.
GHCR_OWNER=your-github-username

# Mutable branch tags are the defaults. Use immutable sha-* tags when pinning
# either service to an exact build.
PROD_IMAGE_TAG=prod
STAGE_IMAGE_TAG=stage

# The server always listens on port 3000 inside the container.
PORT=3000

# Secret key for API authentication (X-API-Key).
API_KEY=change-me-to-a-strong-random-secret

# Minimum log level: debug | info | warn | error.
LOG_LEVEL=info

# Optional: path inside the container to the shared sync configuration.
# Uncomment the volume in docker-compose.yml when setting this value.
SYNC_CONFIG=

# Secrets referenced as ${VAR} in a mounted sync.json.
DIRECTUS_TOKEN=your-directus-static-token
GITHUB_TOKEN=your-github-pat-with-repo-write
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
