# Port the server listens on
PORT=3000

# Secret key for API authentication.
# Set in n8n as the X-API-Key header value.
# Leave empty to disable authentication (not recommended in production).
API_KEY=change-me-to-a-strong-random-secret

# Your GitHub username (used in docker-compose.yml to pull the image from ghcr.io)
GHCR_OWNER=your-github-username
