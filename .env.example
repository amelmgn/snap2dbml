# Port the server listens on
PORT=3000

# Secret key for API authentication (X-API-Key header).
# Leave empty to disable authentication (not recommended in production).
API_KEY=change-me-to-a-strong-random-secret

# Minimum log level: debug | info | warn | error. Default: info.
# debug additionally shows health-check requests and sync internals.
LOG_LEVEL=info

# Your GitHub username (used in docker-compose.yml to pull the image from ghcr.io)
GHCR_OWNER=your-github-username

# Image tag for the production container (docker-compose.yml). Default: prod.
# Pin to an immutable sha tag (e.g. sha-d8cf9b3) for fully deterministic deploys.
#IMAGE_TAG=prod

# Image tag for the staging container (docker-compose.stage.yml). Default: stage.
#STAGE_IMAGE_TAG=stage

# --- Automated sync (optional) ---
# Path to sync.json INSIDE the container. Mount the file via volumes in docker-compose.yml.
# Remove or leave empty to disable the scheduler.
SYNC_CONFIG=/app/sync.json

# Secrets referenced as ${VAR} in sync.json
DIRECTUS_TOKEN=your-directus-static-token
GITHUB_TOKEN=your-github-pat-with-repo-write
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
